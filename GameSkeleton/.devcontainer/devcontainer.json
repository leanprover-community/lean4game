{
  "name": "game",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    }
  },

  "remoteEnv": {
    // don't expose the host's forwarded SSH agent
    "SSH_AUTH_SOCK": ""
  },

  "remoteUser": "node",
  "containerUser": "node",

  "runArgs": ["--cap-drop=ALL", "--security-opt=no-new-privileges:true"]
}
